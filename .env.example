# Optional Umami analytics configuration.
# Leave both values unset to disable analytics without build warnings.
VITE_ANALYTICS_ENDPOINT=https://analytics.example.com
VITE_ANALYTICS_WEBSITE_ID=replace-with-website-id
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-public-anon-key

# Public frontend URL of the deployed Vercel function.
VITE_AI_API_URL=https://your-project.vercel.app/api/analyze

# Server-only variables: configure these in Vercel Project Settings, never in VITE_*.
AI_API_KEY=server-side-only-secret
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
FRONTEND_ORIGIN=https://aikurdestan-design.github.io
